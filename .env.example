# Copiez ce fichier en .env, puis remplissez les valeurs.
#   cp .env.example .env
#
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).
# Ce fichier-ci ne doit contenir aucune valeur réelle : seulement des exemples.

# --- Base de données ---
POSTGRES_USER=agriconnect
POSTGRES_PASSWORD=a-changer-en-local
POSTGRES_DB=agriconnect
POSTGRES_PORT=5432

# URL lue par Prisma. Elle doit reprendre les trois valeurs ci-dessus.
DATABASE_URL=postgresql://agriconnect:a-changer-en-local@localhost:5432/agriconnect?schema=public

# --- Authentification ---
# Laissé vide volontairement. Générez une valeur aléatoire longue :
#   openssl rand -base64 48
# Un JWT_SECRET deviné = n'importe qui peut se faire passer pour le gérant.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- API ---
API_PORT=3000
NODE_ENV=development

# --- Front ---
VITE_API_URL=http://localhost:3000
