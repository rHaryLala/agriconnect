generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMPTABLE
  OUVRIER
  //mise a jours users
  MAGASINIER
  CONTROLEUR_INTERNE
}

model Farm {
  id          String        @id @default(uuid())
  name        String
  location    String?
  users       User[]
  productions Production[]
  stockItem   StockItem[]
  clients     Client[]
  invoices    Invoice[]
  transactions Transaction[]
  stockLocation StockLocation[]
  cattle  Cattle[]
  paddyProcess PaddyProcess[]
  poultryTrackings PoultryTracking[]//mise a jour

  //Nouveau
  employees   Employee[]
  suppliers   Supplier[]
  

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  firstName     String
  lastName      String
  role          Role            @default(OUVRIER)
  farmId        String
  farm          Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)

  employeeId   String?   @unique
  employee  Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  production    Production[]
  stockMovment  StockMovement[]
  transactions Transaction[]
  
  payments    Payment[]

  sentTransfers     StockTransfert[] @relation("TransfertSender")   
  receivedTransfers StockTransfert[] @relation("TransfertReceiver")

  poultryTrackings PoultryTracking[]//mise a jour

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([farmId])
}

model Employee {
  id String   @id @default(uuid())
  firstName   String
  lastName    String
  matricule   String?
  department   String?
  position    String?
  phone   String?

  farmId    String
  farm    Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)

  user    User?
  clientId    String? @unique
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  salaryDeductions   SalaryDeduction[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([farmId])
  @@unique([farmId, matricule])
}

enum ProductionType {
  OEUFS
  LAIT
  VIANDE
  RECOLTES
  //mise a jour
  POULARD
  KUROILER
  PADDY
  HARICOT
}

model Production {
  id          String         @id @default(uuid())
  type        ProductionType
  quantity    Float
  unit        String
  date        DateTime       @default(now())
  notes       String?

  userId      String
  user        User           @relation(fields: [userId], references: [id])
  
  farmId      String
  farm        Farm           @relation(fields: [farmId], references: [id])

  stockItemId String?
  stockItem   StockItem?     @relation(fields: [stockItemId], references: [id])

  variantId   String?
  variant   ProductVariant?   @relation(fields: [variantId],  references: [id])

  createdAt   DateTime       @default(now())

  @@index([farmId, date(sort: Desc)])
}

enum MouvementType {
  IN
  OUT
  AJUSTEMENT
  //mise a jour
  TRANSFERT 
}

model StockItem {
  id          String          @id @default(uuid())
  name        String
  category    String
  quantity    Float           @default(0)
  unit        String
  miniAlert   Float           @default(10)

  farmId      String
  farm        Farm            @relation(fields: [farmId], references: [id])

  locationId String?
  location StockLocation? @relation(fields: [locationId], references: [id])

  movements   StockMovement[]
  production  Production[]
  invoiceItem InvoiceItem[]
  variants     ProductVariant[]
  //lise a jour
  transferItems   StockTransfertItem[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([farmId])
  @@unique([farmId, name])
}

model StockMovement {
  id                 String         @id @default(uuid())
  type               MouvementType
  quantity           Float
  reason             String?
  repeseeQuantity    Float? //mise a jour
  date               DateTime       @default(now())
  userId             String
  user               User           @relation(fields: [userId], references: [id])

  itemId             String
  item               StockItem      @relation(fields: [itemId], references: [id])

// ajout du product variant
  variantId   String?
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])

  originalMovementId  String?
  originalMovement    StockMovement? @relation("MovmentCorrection", fields: [originalMovementId], references: [id])
  corrections        StockMovement[] @relation("MovmentCorrection")
  //mise a jour

  transfertId   String?
  transfert   StockTransfert?   @relation(fields: [transfertId], references: [id])  

  createdAt          DateTime       @default(now())
}

enum ClientType {
  EXTERNE
  INTERNE
  PERSONNEL_UAZ
  CAF
  AGENT_STORE //mise a jour
}

model Client {
  id           String     @id @default(uuid())
  name         String
  phone        String?
  type         ClientType @default(INTERNE) // ny interne (olona normal)
  matriculeuaz String?    @map("matricule_uaz") // Pour identifier l'employé sur le rapport comptable

  farmId       String
  farm         Farm       @relation(fields: [farmId], references: [id])
  invoices     Invoice[]
  transactions Transaction[]

  cattles   Cattle[]    

  employee Employee?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum InvoiceStatus {
  UNPAID
  PAID
  // mise a jour
  PARTIALLY_PAID
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("numero_du_recu")
  totalAmount   Decimal   @map("total_ttc") @db.Decimal(14, 2)
  paidAmount    Decimal   @default(0) @map("montant_regle") @db.Decimal(14, 2)
  dueAmount     Decimal         @map("reste_a_payer") @default(0) @db.Decimal(14, 2)
  status        InvoiceStatus @default(UNPAID) @map("statut_du_paiment")

  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])

  farmId        String
  farm          Farm          @relation(fields: [farmId], references: [id])

  // relation de paiment ici, quand le table paiment sera fini
  invoiceItem InvoiceItem[]
  transactions Transaction[]
  //mise a jour
  payments Payment[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([farmId, status])
  @@unique([farmId, invoiceNumber])
}

//details des articles vendus dans la facture
model InvoiceItem {
  id String @id @default(uuid())
  quantity Float
  unitPrice Decimal   @db.Decimal(14, 2)
  total Decimal   @db.Decimal(14, 2)

  invoiceId String
  invoice Invoice   @relation(fields: [invoiceId], references: [id])

  itemId String
  item StockItem @relation(fields: [itemId], references: [id])

  variantId   String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

//transaction et finances
enum TransactionType{
  RECETTE //argent qui entre
  DEPENSE //argent qui sort
}

model Transaction{
  id String @id @default(uuid())
  amount Decimal    @db.Decimal(14, 2)
  type TransactionType @default(RECETTE)
  reference String? //numereau physique du recuu ou bordereau
  notes String? //remarque ou detail
  date DateTime @default(now())

  //liens avec la facture 
  invoiceId String?
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  userId String
  user User @relation(fields: [userId], references: [id])

  farmId String
  farm Farm @relation(fields: [farmId], references: [id])

  clientId String?
  client Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId, date(sort: Desc)])
  @@index([farmId, type, date(sort: Desc)])
}

// Mise a jour

enum LocationType {
  FERME
  STORE
  TRANSIT // stock en cours de transfert
  MAGASINIER // Depot principal sous la responsabilité du magasinier
}

model StockLocation {
  id String @id @default(uuid())
  name String
  type LocationType @default(FERME)

  farmId String
  farm  Farm  @relation(fields: [farmId], references: [id], onDelete: Cascade)

  stockItem StockItem[]
  //mise a jour
  fromTransfers StockTransfert[] @relation("FromLocation")
  toTransfers   StockTransfert[] @relation("ToLocation")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([farmId, name])
}

//mise a jour: suivi des bovin
enum StatusBovin{
  EN_ELEVAGE
  VENDU
  DECEDE
}

enum EntryTypeBovin {
  NAISSANCE
  ACHAT
}

enum ProductiviteBovin {
  PRODUCTIVE
  TARIE
}

enum ReproductionBovin {
  GESTANTE
  NON_GESTANTE
  ALLAITANTE
  NON_ALLAITANTE
}

model Cattle{
  id String @id @default(uuid())
  nameOrTag String //anarana na fiantsoana anazy
  breed String? //race 
  gender String // male/female
  category    String?   @default("Vache laitière")// Veau, Vache laitière, etc.
  status StatusBovin @default(EN_ELEVAGE)
  productivite     ProductiviteBovin?
  reproduction     ReproductionBovin?

  //Entrée------------------------
  entryType   EntryTypeBovin    @default(NAISSANCE)
  entryDate   DateTime    @default(now())
  birthDate DateTime?

  //SORTIE-------------------------
  saleDate    DateTime?
  salePrice   Decimal?    @db.Decimal(14, 2) //prix unitaire
  signature   String?  // URL/path de la signature ou validation
  clientId    String?
  client    Client? @relation(fields: [clientId], references: [id])

  //Décès / Mortalité---------------
  deathDate   DateTime?
  deathReason   String?   // Motif

  notes String?

  farmId String
  farm Farm @relation(fields: [farmId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@unique([farmId, nameOrTag])
}

// mise a jour: table model paiment et Historique des règlements / versements
enum PaymentMethod{
  CAISSE
  RETENUE_SUR_SALAIRE
}

model Payment {
  id String @id @default(uuid())
  recuNumber String @unique //numero du recu
  amount Decimal    @db.Decimal(14, 2)
  method PaymentMethod @default(CAISSE)
  date DateTime @default(now())

  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  userId    String
  user    User    @relation(fields: [userId], references: [id])

  salaryDeduction SalaryDeduction ?

  createdAt DateTime @default(now())

}

//mise a jour: deduction au salaire pour les personnel
model SalaryDeduction {
  id String @id @default(uuid())
  amount  Decimal   @db.Decimal(14, 2)
  status String @default("En_attente")//en attente na deduit
  period String //deduction du salaire sur le moi du paie ex: 

  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  employeeId String 
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//suivi du riziculture (paddy en riz decortiqué)
model PaddyProcess{
  id String @id @default(uuid())
  lotNumber String
  paddyInputKg Float //quantité akotry engagée
  paddyInputLot Int //quantité akotry par gony engagée
  waveNumber Int @default(1) //vague de sechage
  statu String @default("IN_PROGRESS") //in progress na completed

  riceOutputKg Float? //riz obtenu au final
  note String? // affirmation a faire si il y a

  farmId String
  farm Farm @relation(fields: [farmId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//model ProductVariant mbola tsisy
model ProductVariant{
  id String @id @default(uuid())
  name String //anaran'ilay varieté anle produit, ex: gros model cassé, petit model normal, haricot rouge
  sku String? @unique //Sac de 10 kg = SKU: AGR-BST-10KGSac de 50 kg = SKU: AGR-BST-50KG
  unitPrice Decimal @default(0)   @db.Decimal(14, 2)
  quantity  Float @default(0)

  stockItemId String
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  invoiceItems    InvoiceItem[]

  stockTranferItems StockTransfertItem[]

  movements      StockMovement[]

  productions Production[]

  createdAt   DateTime @default(now())
  updatedAt DateTime    @updatedAt
}

//model stockTransfer avec gestion des transfert inter-emplacement
model StockTransfert {
  id String @id @default(uuid())
  transfertNumber String  @unique
  status    String    @default("PENDING")//PENDING,CANCELLED, COMPLETED
  date    DateTime    @default(now())


  fromLocationId    String
  fromLocation    StockLocation   @relation("FromLocation", fields: [fromLocationId], references: [id])

  toLocationId    String
  toLocation    StockLocation   @relation("ToLocation", fields: [toLocationId], references: [id])

  senderId    String?
  sender    User?    @relation("TransfertSender", fields: [senderId], references: [id])

  receiverId    String?
  receiver    User?   @relation("TransfertReceiver", fields: [receiverId], references: [id])

  items   StockTransfertItem[]

  //mise a jour
  movements      StockMovement[] // Un transfert contient ses 2 mouvements (IN et OUT)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt   
}

//model StockTransferItem
model StockTransfertItem{
  id    String    @id @default(uuid())
  quantity    Float

  transfertId   String
  transfert   StockTransfert   @relation(fields: [transfertId], references: [id])

  itemId    String
  item    StockItem   @relation(fields: [itemId], references: [id])

  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
}


////nouveau enum
enum PoultryType{
  PONDEUSE
  KUROILER
  POULARD
}

enum PoultryStatus{
  EN_ELEVAGE
  EN_COUVEUSE
  VENDU
  DECEDE
}

model PoultryTracking{
  id  String  @id @default(uuid())
  tagOrNumber   String? //numero d'identifiant, de bracelet, ou de lot
  type    PoultryType  
  status    PoultryStatus   @default(EN_ELEVAGE)
  initialAge  Int           @default(0) // Âge initial en semaines à la création
  notes       String?

  // Traçabilité & Sortie
  entryDate  DateTime  @default(now()) // Utilisé pour calculer l'âge dynamique
  exitDate   DateTime?
  exitReason String?
  salePrice  Decimal?   @db.Decimal(14, 2)

  // Relations principales
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Historique des suivis hebdomadaires (1-N)
  weeklyRecords PoultryWeeklyRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([userId])
}

model PoultryWeeklyRecord {
  id                String          @id @default(uuid())
  poultryTrackingId String
  poultryTracking   PoultryTracking @relation(fields: [poultryTrackingId], references: [id], onDelete: Cascade)

  weekNumber Int      // Semaine N° X
  recordDate DateTime @default(now())

  weightKg       Float?   // Poids moyen
  ponteRate      Float?   // Taux de ponte (%)
  mortalityCount Int      @default(0) // Pertes observées cette semaine

  vaccineName String?   // Vaccin administré
  vaccineDate DateTime? // Date d'administration

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poultryTrackingId])
}
//nouveau

model Supplier {
  id    String    @id @default(uuid())
  name    String
  phone   String? 
  email   String?
  address   String?

  farmId    String
  farm    Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)

  purchases   SupplierPurchase[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([farmId])
}

model SupplierPurchase {
  id String   @id   @default(uuid())
  reference   String
  totalAmount   Decimal   @db.Decimal(14, 2)
  paidAmount    Decimal   @default(0) @db.Decimal(14,2)
  date    DateTime    @default(now())

  supplierId    String
  supplier    Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  payments    SupplierPayment[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}


model SupplierPayment {
  id    String  @id @default(uuid())
  amount    Decimal   @db.Decimal(14,2)
  method    PaymentMethod   @default(CAISSE)
  date    DateTime    @default(now())

  purchaseId    String
  purchase    SupplierPurchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
}
