generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMPTABLE
  OUVRIER
}

model Farm {
  id          String       @id @default(uuid())
  name        String
  location    String?
  users       User[]
  productions Production[]
  stockItems  StockItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  firstName      String
  lastName       String
  role           Role            @default(OUVRIER)
  farmId         String
  farm           Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  productions    Production[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([farmId])
}

// --- Module Production ---

enum ProductionType {
  OEUFS
  LAIT
  VIANDE
  RECOLTES
}

model Production {
  id        String         @id @default(uuid())
  type      ProductionType
  quantity  Float
  unit      String
  date      DateTime       @default(now())
  notes     String?

  farmId    String
  farm      Farm           @relation(fields: [farmId], references: [id])

  userId    String
  user      User           @relation(fields: [userId], references: [id])

  createdAt DateTime       @default(now())
}

// --- Module Stock ---

enum MouvementType {
  IN
  OUT
  AJUSTEMENT
}

model StockItem {
  id        String          @id @default(uuid())
  name      String
  category  String
  quantity  Float           @default(0)
  unit      String
  miniAlert Float           @default(10)

  farmId    String
  farm      Farm            @relation(fields: [farmId], references: [id])

  movements StockMovement[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model StockMovement {
  id       String        @id @default(uuid())
  type     MouvementType
  quantity Float
  reason   String?
  date     DateTime      @default(now())

  itemId   String
  item     StockItem     @relation(fields: [itemId], references: [id])

  userId   String
  user     User          @relation(fields: [userId], references: [id])
}