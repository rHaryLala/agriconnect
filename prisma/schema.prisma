generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMPTABLE
  OUVRIER
}

model Farm {
  id  String @id @default(uuid())
  name String 
  location String?
  users User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String 
  firstName String
  lastName String
  role Role @default(OUVRIER)
  farmId String
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  createdAt DateTime @default  (now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
}