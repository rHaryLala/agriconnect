generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMPTABLE
  OUVRIER
  //mise a jours users
  MAGASINIER
  CONTROLEUR_INTERNE
}

model Farm {
  id          String        @id @default(uuid())
  name        String
  location    String?
  users       User[]
  productions Production[]
  stockItem   StockItem[]
  clients     Client[]
  invoices    Invoice[]
  transactions Transaction[]
  stockLocation StockLocation[]
  cattle  Cattle[]
  paddyProcess PaddyProcess[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  firstName     String
  lastName      String
  role          Role            @default(OUVRIER)
  farmId        String
  farm          Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  production    Production[]
  stockMovment  StockMovement[]
  transactions Transaction[]
  
  salaryDeduction SalaryDeduction[]

  sentTransfers     StockTransfer[] @relation("TransferSender")   
  receivedTransfers StockTransfer[] @relation("TransferReceiver")

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([farmId])
}

enum ProductionType {
  OEUFS
  LAIT
  VIANDE
  RECOLTES
  //mise a jour
  POULARD
  KUROILER
  PADDY
}

model Production {
  id          String         @id @default(uuid())
  type        ProductionType
  quantity    Float
  unit        String
  date        DateTime       @default(now())
  notes       String?

  userId      String
  user        User           @relation(fields: [userId], references: [id])
  farmId      String
  farm        Farm           @relation(fields: [farmId], references: [id])

  stockItemId String?
  stockItem   StockItem?     @relation(fields: [stockItemId], references: [id])

  createdAt   DateTime       @default(now())
}

enum MouvementType {
  IN
  OUT
  AJUSTEMENT
  //mise a jour
  TRANFERTS
}

model StockItem {
  id          String          @id @default(uuid())
  name        String
  category    String
  quantity    Float           @default(0)
  unit        String
  miniAlert   Float           @default(10)

  farmId      String
  farm        Farm            @relation(fields: [farmId], references: [id])

  locationId String?
  location StockLocation? @relation(fields: [locationId], references: [id])

  movements   StockMovement[]
  production  Production[]
  invoiceItem InvoiceItem[]
  variants     ProductVariant[]
  //lise a jour
  items   StockTransferItem[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model StockMovement {
  id                 String         @id @default(uuid())
  type               MouvementType
  quantity           Float
  reason             String?
  repeseeQuantity    Float? //mise a jour
  date               DateTime       @default(now())
  userId             String
  user               User           @relation(fields: [userId], references: [id])

  itemId             String
  item               StockItem      @relation(fields: [itemId], references: [id])

  originalMovmentId  String?
  originalMovment    StockMovement? @relation("MovmentCorrection", fields: [originalMovmentId], references: [id])
  corrections        StockMovement[] @relation("MovmentCorrection")
  //mise a jour

  transfertId   String?
  transfert   StockTransfer?   @relation(fields: [transfertId], references: [id], onDelete: Cascade)  

  createdAt          DateTime       @default(now())
}

enum ClientType {
  EXTERNE
  INTERNE
  PERSONNEL_UAZ
  CAF
  AGENT_STORE //mise a jour
}

model Client {
  id           String     @id @default(uuid())
  name         String
  phone        String?
  type         ClientType @default(INTERNE) // ny interne (olona normal)
  matriculeuaz String?    @map("matricule_uaz") // Pour identifier l'employé sur le rapport comptable

  farmId       String
  farm         Farm       @relation(fields: [farmId], references: [id])
  invoices     Invoice[]
  transactions Transaction[]

  cattles   Cattle[]    

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum InvoiceStatus {
  UNPAID
  PAID
  // mise a jour
  PARTIALLY_PAID
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("numero_du_recu")
  totalAmount   Float         @map("total_ttc")
  paidAmount    Float         @default(0) @map("montant_regle")
  dueAmount     Float         @map("reste_a_payer")
  status        InvoiceStatus @default(UNPAID) @map("statut_du_paiment")

  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])

  farmId        String
  farm          Farm          @relation(fields: [farmId], references: [id])

  // relation de paiment ici, quand le table paiment sera fini
  invoiceItem InvoiceItem[]
  transactions Transaction[]
  //mise a jour
  payments Payment[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

//details des articles vendus dans la facture
model InvoiceItem {
  id String @id @default(uuid())
  quantity Float
  unitPrice Float
  total Float

  invoiceId String
  invoice Invoice   @relation(fields: [invoiceId], references: [id])

  itemId String
  item StockItem @relation(fields: [itemId], references: [id])

  variantId   String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

//transaction et finances
enum TransactionType{
  RECETTE //argent qui entre
  DEPENSE //argent qui sort
}

model Transaction{
  id String @id @default(uuid())
  amount Float
  type TransactionType @default(RECETTE)
  reference String? //numereau physique du recuu ou bordereau
  notes String? //remarque ou detail
  date DateTime @default(now())

  //liens avec la facture 
  invoiceId String?
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  userId String
  user User @relation(fields: [userId], references: [id])

  farmId String
  farm Farm @relation(fields: [farmId], references: [id])

  clientId String?
  client Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mise a jour

enum LocationType {
  FERME
  STORE
  TRANSIT // stock en cours de transfert
  MAGASINIER // Depot principal sous la responsabilité du magasinier
}

model StockLocation {
  id String @id @default(uuid())
  name String
  type LocationType @default(FERME)

  farmId String
  farm  Farm  @relation(fields: [farmId], references: [id], onDelete: Cascade)

  stockItem StockItem[]
  //mise a jour
  fromTransfers StockTransfer[] @relation("FromLocation")
  toTransfers   StockTransfer[] @relation("ToLocation")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

//mise a jour: suivi des bovin
enum StatusBovin{
  EN_ELEVAGE
  VENDU
  DECEDE
}

enum EntryTypeBovin{
  NAISSANCE
  ACHAT
}

model Cattle{
  id String @id @default(uuid())
  nameOrTag String //anarana na fiantsoana anazy
  gender String // male/female
  category    String?   @default("Vache laitière")// Veau, Vache laitière, etc.
  status StatusBovin @default(EN_ELEVAGE)

  //Entrée------------------------
  entryType   EntryTypeBovin    @default(NAISSANCE)
  entryDate   DateTime    @default(now())
  birthDate DateTime?

  //SORTIE-------------------------
  saleDate    DateTime?
  salePrice   Float? //prix unitaire
  signature   String?  // URL/path de la signature ou validation
  clientId    String?
  client    Client? @relation(fields: [clientId], references: [id])

  //Décès / Mortalité---------------
  deathDate   DateTime?
  deathReason   String?   // Motif

  notes String?

  farmId String
  farm Farm @relation(fields: [farmId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// mise a jour: table model paiment et Historique des règlements / versements
enum PaymentMethod{
  CAISSE
  RETENUE_SUR_SALAIRE
}

model Payment {
  id String @id @default(uuid())
  recuNumber String @unique //numero du recu
  amount Float
  method PaymentMethod @default(CAISSE)
  date DateTime @default(now())

  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  salaryDeduction SalaryDeduction ?

  createdAt DateTime @default(now())

}

//mise a jour: deduction au salaire pour les personnel
model SalaryDeduction {
  id String @id @default(uuid())
  amount  Float
  status String @default("En_attente")//en attente na deduit
  period String //deduction du salaire sur le moi du paie ex: 

  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  employeeId String 
  employee User @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//suivi du riziculture (paddy en riz decortiqué)
model PaddyProcess{
  id String @id @default(uuid())
  lotNumber String
  paddyInputKg Float //quantité akotry engagée
  paddyInputLot Int //quantité akotry par gony engagée
  waveNumber Int @default(1) //vague de sechage
  statu String @default("IN_PROGRESS") //in progress na completed

  riceOutputKg Float? //riz obtenu au final
  note String? // affirmation a faire si il y a

  farmId String
  farm Farm @relation(fields: [farmId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//model ProductVariant mbola tsisy
model ProductVariant{
  id String @id @default(uuid())
  name String //anaran'ilay varieté anle produit, ex: gros model cassé, petit model normal, haricot rouge
  sku String? @unique //Sac de 10 kg = SKU: AGR-BST-10KGSac de 50 kg = SKU: AGR-BST-50KG
  unitPrice Float @default(0)
  quantity  Float @default(0)

  stockItemId String
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  invoiceItems    InvoiceItem[]

  stockTranferItems StockTransferItem[]

  createdAt   DateTime @default(now())
  updatedAt DateTime    @updatedAt
}

//model stockTransfer avec gestion des transfert inter-emplacement
model StockTransfer {
  id String @id @default(uuid())
  transfertNumber String  @unique
  status    String    @default("PENDING")//PENDING,CANCELLED, COMPLETED
  date    DateTime    @default(now())


  fromLocationId    String
  fromLocation    StockLocation   @relation("FromLocation", fields: [fromLocationId], references: [id])

  toLocationId    String
  toLocation    StockLocation   @relation("ToLocation", fields: [toLocationId], references: [id])

  senderId    String?
  sender    User?    @relation("TransferSender", fields: [senderId], references: [id])

  receiverId    String?
  receiver    User?   @relation("TransferReceiver", fields: [receiverId], references: [id])

  items   StockTransferItem[]

  //mise a jour
  movements      StockMovement[] // Un transfert contient ses 2 mouvements (IN et OUT)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt   
}

//model StockTransferItem
model StockTransferItem{
  id    String    @id @default(uuid())
  quantity    Float

  transfertId   String
  transfert   StockTransfer   @relation(fields: [transfertId], references: [id])

  itemId    String
  item    StockItem   @relation(fields: [itemId], references: [id])

  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
}