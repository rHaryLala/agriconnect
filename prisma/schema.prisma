generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMPTABLE
  OUVRIER
}

model Farm {
  id  String @id @default(uuid())
  name String 
  location String?
  users User[]
  productions Production[]
  stockItem StockItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String 
  firstName String
  lastName String
  role Role @default(OUVRIER)
  farmId String
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  production Production[]
  stockMovment StockMovement[]

  createdAt DateTime @default  (now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
}

enum ProductionType {
  OEUFS
  LAIT
  VIANDE
  RECOLTES
}

model Production {
  id String @id @default(uuid())
  type ProductionType
  quantity Float
  unit String
  date DateTime @default(now())
  notes String?

  userId String
  user User @relation(fields: [userId], references: [id])
  farmId String 
  farm Farm @relation(fields: [farmId], references: [id])

  stockItemId String?
  stockItem StockItem? @relation(fields: [stockItemId], references: [id])

  createdAt DateTime @default(now())
}

enum MouvementType {
  IN 
  OUT
  AJUSTEMENT
}

model StockItem {
  id String @id @default(uuid())
  name String
  category String
  quantity Float @default(0)
  unit String
  miniAlert Float @default(10)

  farmId String
  farm Farm @relation(fields: [farmId], references: [id])
  movements   StockMovement[]
  production Production[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model StockMovement {
  id String @id @default(uuid())
  type MouvementType
  quantity Float
  reason String?
  date DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id])

  itemId String
  item StockItem @relation(fields: [itemId], references: [id])

  originalMovmentId String?
  originalMovment StockMovement? @relation("MovmentCorrection", fields: [originalMovmentId], references: [id])
  corrections StockMovement[] @relation("MovmentCorrection")

  createdAt DateTime @default(now())
}

