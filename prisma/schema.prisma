generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMPTABLE
  OUVRIER
}

model Farm {
  id          String        @id @default(uuid())
  name        String
  location    String?
  users       User[]
  productions Production[]
  stockItem   StockItem[]
  clients     Client[]
  invoices    Invoice[]
  transactions Transaction[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  firstName     String
  lastName      String
  role          Role            @default(OUVRIER)
  farmId        String
  farm          Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  production    Production[]
  stockMovment  StockMovement[]
  transactions Transaction[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([farmId])
}

enum ProductionType {
  OEUFS
  LAIT
  VIANDE
  RECOLTES
}

model Production {
  id          String         @id @default(uuid())
  type        ProductionType
  quantity    Float
  unit        String
  date        DateTime       @default(now())
  notes       String?

  userId      String
  user        User           @relation(fields: [userId], references: [id])
  farmId      String
  farm        Farm           @relation(fields: [farmId], references: [id])

  stockItemId String?
  stockItem   StockItem?     @relation(fields: [stockItemId], references: [id])

  createdAt   DateTime       @default(now())
}

enum MouvementType {
  IN
  OUT
  AJUSTEMENT
}

model StockItem {
  id          String          @id @default(uuid())
  name        String
  category    String
  quantity    Float           @default(0)
  unit        String
  miniAlert   Float           @default(10)

  farmId      String
  farm        Farm            @relation(fields: [farmId], references: [id])
  movements   StockMovement[]
  production  Production[]
  invoiceItem InvoiceItem[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model StockMovement {
  id                 String         @id @default(uuid())
  type               MouvementType
  quantity           Float
  reason             String?
  date               DateTime       @default(now())
  userId             String
  user               User           @relation(fields: [userId], references: [id])

  itemId             String
  item               StockItem      @relation(fields: [itemId], references: [id])

  originalMovmentId  String?
  originalMovment    StockMovement? @relation("MovmentCorrection", fields: [originalMovmentId], references: [id])
  corrections        StockMovement[] @relation("MovmentCorrection")

  createdAt          DateTime       @default(now())
}

enum ClientType {
  EXTERNE
  PERSONNEL_UAZ
  CAF
  STORE
}

model Client {
  id           String     @id @default(uuid())
  name         String
  phone        String?
  type         ClientType @default(EXTERNE) // externe sy personnelle iany ny
  matriculeuaz String?    @map("matricule_uaz") // Pour identifier l'employé sur le rapport comptable

  farmId       String
  farm         Farm       @relation(fields: [farmId], references: [id])
  invoices     Invoice[]
  transactions Transaction[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum InvoiceStatus {
  UNPAID
  PAID
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("numero_du_recu")
  totalAmount   Float         @map("total_ttc")
  paidAmount    Float         @default(0) @map("montant_reglé")
  dueAmount     Float         @map("reste_a_payer")
  status        InvoiceStatus @default(UNPAID) @map("statut_du_paiment")

  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])

  farmId        String
  farm          Farm          @relation(fields: [farmId], references: [id])

  // relation de paiment ici, quand le table paiment sera fini
  invoiceItem InvoiceItem[]
  transactions Transaction[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

//details des articles vendus dans la facture
model InvoiceItem {
  id String @id @default(uuid())
  quantity Float
  unitPrice Float
  total Float

  invoiceId String
  invoice Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  itemId String
  item StockItem @relation(fields: [itemId], references: [id])
}

//transaction et finances
enum TransactionType{
  RECETTE //argent qui entre
  DEPENSE //argent qui sort
}

model Transaction{
  id String @id @default(uuid())
  amount Float
  type TransactionType @default(RECETTE)
  reference String? //numereau physique du recuu ou bordereau
  notes String? //remarque ou detail
  date DateTime @default(now())

  //liens avec la facture 
  invoiceId String?
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  userId String
  user User @relation(fields: [userId], references: [id])

  farmId String
  farm Farm @relation(fields: [farmId], references: [id])

  clientId String?
  client Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}