# --- Dépendances ---
node_modules/
.pnp/
.pnp.js

# --- Build ---
dist/
build/
out/
*.tsbuildinfo

# --- Variables d'environnement ---
# Aucun secret ne doit être versionné. Seul .env.example l'est.
.env
.env.local
.env.*.local
!.env.example

# --- Prisma (bases locales) ---
prisma/*.db
prisma/*.db-journal

# --- Fichiers produits par l'application ---
# Les rapports PDF et Excel générés se régénèrent : ils n'ont rien à faire ici.
exports/
uploads/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Tests ---
coverage/
.nyc_output/

# --- Caches d'outils ---
.eslintcache
.vite/
.turbo/

# --- Éditeurs ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# --- Système ---
.DS_Store
Thumbs.db
desktop.ini
