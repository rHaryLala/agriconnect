# API backend
VITE_API_URL=http://localhost:3000

# Bascule temporaire : true = mockup local (login + gestion utilisateurs), false = vrai backend
VITE_USE_MOCK_API=true

# Sentry — laisser vide pour desactiver totalement le monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
