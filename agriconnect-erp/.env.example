# API backend. Ne pas inclure /api/v1 : le prefixe est ajoute par apiClient.
VITE_API_URL=http://localhost:3000

# false = API reelle, true = jeux de donnees locaux.
#
# En mode API reelle, chaque domaine lie retombe automatiquement sur ses donnees
# locales si le serveur est injoignable ou repond en 5xx (withMockFallback).
# Un 4xx, lui, remonte : c'est une reponse du serveur, pas une panne.
#
# Domaines lies : auth, users, dashboard, stock, bovins, volailles (Kuroiler).
# Les autres restent locaux, voir LIAISON_FRONT_BACK.md.
VITE_USE_MOCK_API=false

# Sentry — laisser vide pour desactiver totalement le monitoring.
# Ne demarre qu'apres consentement de l'utilisateur (bandeau cookies).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
